<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.wuzhangf</groupId>
  <artifactId>agent-code-boot</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>agent-code-boot</name>
  <description>Spring Boot host for the agent-code engine; pairs with CodeAgent Desktop.</description>
  <url>https://github.com/wuzhangf/agent-code-boot</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>wuzhangf</id>
    </developer>
  </developers>

  <properties>
    <java.version>21</java.version>
    <!-- Pinned engine line. Bump together with the BOM release. -->
    <agent.code.version>0.1.0-worker-writable.17</agent.code.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.steercrew.agtcode</groupId>
        <artifactId>agent-code-bom</artifactId>
        <version>${agent.code.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- The engine. Closed-source artifact, version managed by agent-code-bom. -->
    <dependency>
      <groupId>com.steercrew.agtcode</groupId>
      <artifactId>agent-code-runtime</artifactId>
    </dependency>

    <!-- The public HTTP surface (BusinessHttpServer + v1/v2 dispatch). -->
    <dependency>
      <groupId>com.steercrew.agtcode</groupId>
      <artifactId>agent-http-server</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Engine artifacts are consumed as binaries, not source.
    Until they are published to a Maven repository, resolve them from a local
    repository that already contains the installed build, e.g.:

      mvn -Dmaven.repo.local=D:/project/devin-workspace/.m2 package

    When the engine lands on a shared repository, declare it here:

    <repositories>
      <repository>
        <id>agent-code-releases</id>
        <url>https://<engine-repo-host>/maven</url>
      </repository>
    </repositories>
  -->

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
